%% ===========================================================================
%%  ttuthesis2026.cls -- Texas Tech University thesis/dissertation class,
%%  formatted per the Graduate School manual and producing a tagged,
%%  accessibility-compliant PDF.  v1.0 (2026-08-22).
%%
%%  Do not edit this file.  Everything you can change lives in
%%  config/thesis-config.tex.  See README.md.
%%
%%  Engine: LuaLaTeX only.  main.tex must carry \DocumentMetadata{...} with
%%  tagging=on BEFORE \documentclass.
%% ===========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{ttuthesis2026}[2026/08/22 v1.0 TTU thesis/dissertation]

\LoadClass[12pt,oneside,letterpaper]{report}

%% ---------------------------------------------------------------------------
%% 1. PACKAGES.  Deliberately short.  Excluded because they break PDF tagging:
%%    titlesec, caption, subcaption (currently-incompatible upstream);
%%    tocloft and fancyhdr (compatible, but the kernel path is simpler and
%%    keeps every ToC entry linked); adjustbox (rejects the alt= key).
%% ---------------------------------------------------------------------------
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{geometry}
\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{setspace}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{etoolbox}

%% ---------------------------------------------------------------------------
%% 2. FONTS -- TeX Gyre Termes (Times metrics) + matching OpenType math.
%%    Loaded by FILE NAME: the family-name lookup needs a current luaotfload
%%    database, which a fresh MiKTeX does not have.
%%    MiKTeX packages required: tex-gyre, tex-gyre-math.
%% ---------------------------------------------------------------------------
\setmainfont{texgyretermes}[
  Extension      = .otf ,
  UprightFont    = *-regular ,
  BoldFont       = *-bold ,
  ItalicFont     = *-italic ,
  BoldItalicFont = *-bolditalic ]
\setmathfont{texgyretermes-math.otf}

%% ---------------------------------------------------------------------------
%% 3. CONFIGURATION KEYS  --  \ThesisSetup{...}
%%    Every value a student may set. Invalid values produce a plain-English
%%    error naming the key and its allowed values.
%% ---------------------------------------------------------------------------
\ExplSyntaxOn

\dim_new:N   \g_ttu_leftmargin_dim
\dim_gset:Nn \g_ttu_leftmargin_dim { 1in }
\tl_new:N    \g_ttu_spacing_tl
\tl_gset:Nn  \g_ttu_spacing_tl { onehalf }

\tl_new:N \ttu@title          \tl_gset:Nn \ttu@title          {Untitled}
\tl_new:N \ttu@firstname      \tl_gset:Nn \ttu@firstname      {Firstname}
\tl_new:N \ttu@middleinitial  \tl_gset:Nn \ttu@middleinitial  {}
\tl_new:N \ttu@lastname       \tl_gset:Nn \ttu@lastname       {Lastname}
\tl_new:N \ttu@credentials    \tl_gset:Nn \ttu@credentials    {}
\tl_new:N \ttu@department     \tl_gset:Nn \ttu@department     {Department}
\tl_new:N \ttu@degree         \tl_gset:Nn \ttu@degree         {Doctor~of~Philosophy}
\tl_new:N \ttu@degreetype     \tl_gset:Nn \ttu@degreetype     {dissertation}
\tl_new:N \ttu@chair          \tl_gset:Nn \ttu@chair          {Committee~Chair}
\tl_new:N \ttu@dean           \tl_gset:Nn \ttu@dean           {Dean}
\tl_new:N \ttu@month          \tl_gset:Nn \ttu@month          {December}
\tl_new:N \ttu@year           \tl_gset:Nn \ttu@year           {2026}
\tl_new:N \ttu@keywords       \tl_gset:Nn \ttu@keywords       {}
%% output-name is read by the build scripts, not by LaTeX; the key exists here
%% only so that setting it in the config file is not an unknown-key error.
\tl_new:N \ttu@outputname     \tl_gset:Nn \ttu@outputname     {}
\clist_new:N \g_ttu_committee_clist
\bool_new:N  \g_ttu_journalabbrev_bool
%% structure = chapters (the default) or sections; see section 6b.
\bool_new:N  \g_ttu_sections_bool
\cs_new_protected:Npn \ttu_if_sections:nn #1#2
  { \bool_if:NTF \g_ttu_sections_bool {#1} {#2} }
\cs_new_eq:NN \ttu@ifsections \ttu_if_sections:nn

\cs_new_protected:Npn \ttu_badvalue:nnn #1#2#3
  {
    \ClassError{ttuthesis2026}
      { The~value~"#2"~is~not~allowed~for~\ThesisSetup~key~"#1" }
      { Open~config/thesis-config.tex~and~set~#1~to~one~of:~#3. }
  }

\keys_define:nn { ttu }
  {
    left-margin .code:n =
      {
        \str_case:nnF {#1}
          {
            {1in}   { \dim_gset:Nn \g_ttu_leftmargin_dim {1in}   }
            {1.0in} { \dim_gset:Nn \g_ttu_leftmargin_dim {1in}   }
            {1.5in} { \dim_gset:Nn \g_ttu_leftmargin_dim {1.5in} }
          }
          { \ttu_badvalue:nnn {left-margin}{#1}{1in~or~1.5in} }
      } ,
    line-spacing .code:n =
      {
        \str_case:nnF {#1}
          {
            {onehalf} { \tl_gset:Nn \g_ttu_spacing_tl {onehalf} }
            {double}  { \tl_gset:Nn \g_ttu_spacing_tl {double}  }
          }
          { \ttu_badvalue:nnn {line-spacing}{#1}{onehalf~or~double} }
      } ,
    degree-type .code:n =
      {
        \str_case:nnF {#1}
          {
            {thesis}       { \tl_gset:Nn \ttu@degreetype {thesis}       }
            {dissertation} { \tl_gset:Nn \ttu@degreetype {dissertation} }
          }
          { \ttu_badvalue:nnn {degree-type}{#1}{thesis~or~dissertation} }
      } ,
    structure .code:n =
      {
        \str_case:nnF {#1}
          {
            {chapters} { \bool_gset_false:N \g_ttu_sections_bool }
            {sections} { \bool_gset_true:N  \g_ttu_sections_bool }
          }
          { \ttu_badvalue:nnn {structure}{#1}{chapters~or~sections} }
      } ,
    journal-abbreviations .code:n =
      {
        \str_case:nnF {#1}
          {
            {true}  { \bool_gset_true:N  \g_ttu_journalabbrev_bool }
            {false} { \bool_gset_false:N \g_ttu_journalabbrev_bool }
          }
          { \ttu_badvalue:nnn {journal-abbreviations}{#1}{true~or~false} }
      } ,
    title           .tl_gset:N = \ttu@title ,
    first-name      .tl_gset:N = \ttu@firstname ,
    middle-initial  .tl_gset:N = \ttu@middleinitial ,
    last-name       .tl_gset:N = \ttu@lastname ,
    credentials     .tl_gset:N = \ttu@credentials ,
    department      .tl_gset:N = \ttu@department ,
    degree          .tl_gset:N = \ttu@degree ,
    chair           .tl_gset:N = \ttu@chair ,
    dean            .tl_gset:N = \ttu@dean ,
    month           .tl_gset:N = \ttu@month ,
    year            .tl_gset:N = \ttu@year ,
    keywords        .tl_gset:N = \ttu@keywords ,
    output-name     .tl_gset:N = \ttu@outputname ,
    committee       .clist_gset:N = \g_ttu_committee_clist ,
    unknown         .code:n =
      {
        \ClassError{ttuthesis2026}
          { \ThesisSetup~does~not~have~a~key~called~"\l_keys_key_str" }
          { Check~the~spelling~against~the~key~list~in~config/thesis-config.tex. }
      } ,
  }

%% Name assembled once, used by the running header, the copyright page and
%% the title page.  The middle initial and credentials disappear cleanly when
%% left empty.
\cs_new:Npn \ttu@shortname
  {
    \ttu@firstname \c_space_tl
    \tl_if_empty:NF \ttu@middleinitial { \ttu@middleinitial . \c_space_tl }
    \ttu@lastname
  }
\cs_new:Npn \ttu@fullname
  {
    \ttu@shortname
    \tl_if_empty:NF \ttu@credentials { ,~\ttu@credentials }
  }

\NewDocumentCommand \ThesisSetup { +m }
  {
    \keys_set:nn { ttu } {#1}
    \ttu_apply_setup:
  }

\cs_new_protected:Npn \ttu_apply_setup:
  {
    \geometry{ left = \dim_use:N \g_ttu_leftmargin_dim }
    \str_if_eq:eeTF { \g_ttu_spacing_tl } { double }
      { \doublespacing } { \onehalfspacing }
    \bool_if:NT \g_ttu_journalabbrev_bool { \ttu@usejournalabbreviations }
    \bool_if:NT \g_ttu_sections_bool { \ttu@usesectionstructure }
    \int_compare:nNnT { \str_count:N \ttu@title } > { 238 }
      {
        \ClassWarning{ttuthesis2026}
          { The~title~is~longer~than~the~238~characters~the~TTU~manual~allows~
            (p.17).~Shorten~it~in~config/thesis-config.tex }
      }
  }

%% Committee list, one member per line, for the title page.
\cs_new_protected:Npn \ttu_committee_lines:
  { \clist_use:Nn \g_ttu_committee_clist { \\ } }
\cs_new_eq:NN \ttu@committeelines \ttu_committee_lines:

\ExplSyntaxOff

%% ---------------------------------------------------------------------------
%% 4. PAGE GEOMETRY  (manual p.14)
%%    left 1.0in (or 1.5in via \ThesisSetup), top/right/bottom 1.0in.
%%    textheight 9.0in with footskip 0.5in puts the page number exactly 0.5in
%%    from the bottom; headsep 24.27pt puts the TOP of the running header text
%%    0.5in (36pt) below the top edge of the sheet, which is what the manual
%%    measures.  The header box hangs above the text block, so headsep is the
%%    only lever: shrinking it lowers the header without moving the body, and
%%    the value is calibrated -- measure with pdftotext -bbox before changing
%%    it.  US Letter is assumed (the manual is silent on paper size).
%% ---------------------------------------------------------------------------
\geometry{letterpaper,left=1.0in,right=1.0in,top=1.0in,
          textheight=9.0in,
          headheight=15pt,headsep=24.27pt,footskip=0.5in,
          includehead=false,includefoot=false}
\onehalfspacing

%% ---------------------------------------------------------------------------
%% 5. RUNNING HEADER AND PAGE NUMBER  (manual p.15)
%%    Hand-rolled kernel page styles; \@oddhead/\@oddfoot material is
%%    artifacted automatically, so it stays out of the structure tree.
%%    The header starts on the Acknowledgments page: title and copyright use
%%    ttuempty, everything from \ThesisFrontMatter on uses ttumain.
%% ---------------------------------------------------------------------------
\newcommand{\ttu@runhead}{%
  \fontsize{11}{13}\selectfont
  Texas Tech University, \textit{\ttu@shortname}, \ttu@month\ \ttu@year}

%% The page number is centred on the PHYSICAL PAGE, not on the text block
%% (manual p.15: "bottom of the page, centered").  The head/foot boxes are
%% \textwidth wide and start at the left text margin, so a plain \hfil-\hfil
%% centres on the text block -- which is the page centre only when the left
%% and right margins are equal.  In the 1.5in-left-margin variant that would
%% put the number 18pt right of centre.  This steps out to the true page
%% centre first, then sets the number in a zero-width box around it, so both
%% variants land on x = 0.5\paperwidth.
\newcommand{\ttu@pagecentre}[1]{%
  \hspace*{\dimexpr0.5\paperwidth-1in-\hoffset-\oddsidemargin\relax}%
  \hb@xt@\z@{\hss#1\hss}\hfil}

\newcommand{\ps@ttumain}{%
  \renewcommand{\@oddhead}{\hfill\ttu@runhead}%
  \renewcommand{\@evenhead}{\hfill\ttu@runhead}%
  \renewcommand{\@oddfoot}{\ttu@pagecentre{\normalfont\normalsize\thepage}}%
  \renewcommand{\@evenfoot}{\ttu@pagecentre{\normalfont\normalsize\thepage}}%
  \renewcommand{\@mkboth}[2]{}%
  \renewcommand{\chaptermark}[1]{}%
  \renewcommand{\sectionmark}[1]{}%
}
\newcommand{\ps@ttuempty}{%
  \renewcommand{\@oddhead}{}\renewcommand{\@evenhead}{}%
  \renewcommand{\@oddfoot}{}\renewcommand{\@evenfoot}{}%
  \renewcommand{\@mkboth}[2]{}%
}
%% report.cls forces \thispagestyle{plain} at every chapter opening, so plain
%% must carry the same header/footer or chapter first pages lose them.
\let\ps@plain\ps@ttumain
\pagestyle{ttumain}

%% ---------------------------------------------------------------------------
%% 6. HEADINGS  (manual pp.21-22) -- latex-lab heading instances, no titlesec.
%%
%%    Chapters are Roman ("CHAPTER I"); everything numbered BELOW a chapter is
%%    arabic-on-arabic (1.1, 1.1.1, Figure 1.1, Table 1.1, Eq. 1.1), which is
%%    what \ttu@chapnum provides.  In the appendices it switches to the letter.
%%
%%    SPACING SCHEME.  The manual fixes only "chapters start a new page" and
%%    "multi-line headings are single-spaced"; the rest is a deliberate,
%%    consistent ladder that shrinks with depth so a reader can tell the level
%%    apart by the space around it as well as by the font:
%%       level 1  before 12pt  after 6pt
%%       level 2  before 10pt  after 5pt
%%       level 3  before  8pt  after 4pt
%%       level 4  before  6pt  after 3pt
%%       level 5  run-in, before 6pt
%%    Chapter openings: 4pt between the "CHAPTER I" line and the title, 8pt
%%    between the title and the first line of text.
%% ---------------------------------------------------------------------------
\renewcommand{\thechapter}{\Roman{chapter}}
\renewcommand{\chaptername}{CHAPTER}

\newcommand{\ttu@chapnum}{\arabic{chapter}}
\renewcommand{\thesection}      {\ttu@chapnum.\arabic{section}}
\renewcommand{\thesubsection}   {\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\renewcommand{\thefigure}       {\ttu@chapnum.\arabic{figure}}
\renewcommand{\thetable}        {\ttu@chapnum.\arabic{table}}
\renewcommand{\theequation}     {\ttu@chapnum.\arabic{equation}}

\newcommand{\ttu@chapterfont}{\fontsize{14}{16.8}\selectfont}
\newcommand{\ttu@sectionfont}{\fontsize{13}{15.6}\selectfont}
%% Chapter head sits flush on the top margin: -30pt lift plus the +7.27pt
%% latex-lab correction.  Calibrated against the manual -- do not change.
\newlength{\ttu@chaptop}\setlength{\ttu@chaptop}{-22.73pt}

\@ifpackageloaded{latex-lab-testphase-sec}{%
  \DeclareInstance{headformat}{ttu@chapter}{display}
    {
      heading-indent    = 0pt ,
      title-format      = {\MakeUppercase{#1}} ,
      number-title-sep  = 4pt ,
    }
  \DeclareInstance{heading}{chapter}{display}
    {
      name                 = chapter ,
      level                = 0 ,
      placement            = top ,
      before-vspace        = \ttu@chaptop ,
      after-penalty-vspace = 0pt ,
      after-vspace         = 8pt ,
      prefix               = {\MakeUppercase{\chaptername}} ,
      number-format        = \thechapter ,
      heading-decls        = {\normalfont\singlespacing\ttu@chapterfont
                              \bfseries\centering} ,
      headformat-instance  = ttu@chapter ,
      mark-cmd             = \chaptermark{#1} ,
    }
  \DeclareInstance{headformat}{ttu@section}{hang}
    { heading-indent = 0pt , number-title-sep = 1em }
  \DeclareInstance{heading}{section}{display}
    {
      name                = section ,
      level               = 1 ,
      before-vspace       = 12pt ,
      after-vspace        = 6pt ,
      heading-decls       = {\normalfont\singlespacing\ttu@sectionfont
                             \bfseries\raggedright} ,
      headformat-instance = ttu@section ,
      mark-cmd            = \sectionmark{#1} ,
    }
  \DeclareInstance{heading}{subsection}{display}
    {
      name                = subsection ,
      parent-name         = section ,
      level               = 2 ,
      before-vspace       = 10pt ,
      after-vspace        = 5pt ,
      heading-decls       = {\normalfont\normalsize\bfseries\raggedright
                             \singlespacing} ,
      headformat-instance = ttu@section ,
      mark-cmd            = \subsectionmark{#1} ,
    }
  \DeclareInstance{heading}{subsubsection}{display}
    {
      name                = subsubsection ,
      parent-name         = subsection ,
      level               = 3 ,
      before-vspace       = 8pt ,
      after-vspace        = 4pt ,
      heading-decls       = {\normalfont\normalsize\itshape\raggedright
                             \singlespacing} ,
      headformat-instance = ttu@section ,
    }
  \DeclareInstance{heading}{paragraph}{display}
    {
      name                = paragraph ,
      parent-name         = subsubsection ,
      level               = 4 ,
      before-vspace       = 6pt ,
      after-vspace        = 3pt ,
      heading-decls       = {\normalfont\normalsize\raggedright\singlespacing} ,
      headformat-instance = ttu@section ,
    }
  \DeclareInstance{headformat}{ttu@subparagraph}{runin}
    { heading-indent = \parindent , title-format = {#1.} }
  \DeclareInstance{heading}{subparagraph}{runin}
    {
      name                = subparagraph ,
      parent-name         = paragraph ,
      level               = 5 ,
      before-vspace       = 6pt ,
      after-vspace        = 0.6em ,
      heading-decls       = {\normalfont\normalsize\itshape} ,
      headformat-instance = ttu@subparagraph ,
    }
}{%
  \ClassError{ttuthesis2026}
    {latex-lab-testphase-sec is not loaded}
    {main.tex must start with \string\DocumentMetadata{...tagging=on...}
     before \string\documentclass.}%
}

\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}

%% ---------------------------------------------------------------------------
%% 6b. STRUCTURE WITHOUT CHAPTERS  --  \ThesisSetup{structure = sections}
%%
%%    A masters thesis is often short enough that chapters are the wrong unit:
%%    the document is a run of numbered sections, "1. INTRODUCTION", "1.1
%%    Background", and so on.  Setting structure = sections makes \section the
%%    top-level command and shifts every level below it up by one.  Nothing
%%    else about the document changes: the front matter, the running header,
%%    the page-number transitions and the three lists are identical.
%%
%%    VISUAL STYLE.  In the BODY there is no chapter-style banner: \section
%%    prints exactly like a chapters-mode \section (bold, flush left, run on
%%    the same page as what precedes it), \subsection like a chapters-mode
%%    \subsection, and so on down to \subparagraph.  Body sections do not
%%    force a page break -- \ThesisMainMatter's own \clearpage puts the very
%%    first one on the fresh arabic-page-1 that opens the body, and
%%    \ThesisBibliography carries its own \clearpage -- but a plain \section
%%    in the middle of the body runs on from the text above it.
%%
%%    The APPENDICES are the exception, and deliberately so: an appendix is a
%%    major division, so each one opens on its own page under a centred,
%%    uppercase banner, like the Bibliography and the Abstract.  Section 14
%%    re-declares the section heading instance and wraps \section to do that,
%%    for the appendix run only.
%%
%%    WHY THIS NUMBERING.  The manual (p.22) leaves decimal numbering optional
%%    but requires that a document which uses it use it everywhere, floats and
%%    equations included.  So the top level is "1", "2", subheadings are "1.1"
%%    and "1.1.1", and figures, tables and equations restart inside each
%%    top-level section as 1.1, 1.2, ... exactly as they restart inside each
%%    chapter in the other mode.  Three numbered levels and three listed
%%    levels, the same count as chapters mode -- only the depth at which the
%%    document starts is different.
%%
%%    TAGGING.  The role a heading gets in the PDF comes from the "level" key
%%    of its latex-lab instance, not from its name: level 0 is tagged H1, level
%%    1 is H2, and so on.  Re-declaring the same instances with the levels
%%    shifted is therefore the whole of the remapping -- \section becomes H1,
%%    \subsection H2, \subsubsection H3, \paragraph H4, \subparagraph H5, with
%%    no gap anywhere.  The chapter instance stays declared at level 0 because
%%    the front and back divisions (Table of Contents, Abstract, Bibliography)
%%    are \chapter* headings and must stay top-level, which the manual
%%    requires and which keeps them H1 alongside the numbered sections.
%% ---------------------------------------------------------------------------

%% What the top-level heading prints in front of its title.  \ThesisAppendices
%% swaps it for "APPENDIX A".
\newcommand{\ttu@secnumber}{\thesection.}

\newcommand{\ttu@sectionheadings}{%
  \DeclareInstance{heading}{section}{display}
    {
      name                = section ,
      level               = 0 ,
      before-vspace       = 12pt ,
      after-vspace        = 6pt ,
      number-format       = \ttu@secnumber ,
      heading-decls       = {\normalfont\singlespacing\ttu@sectionfont
                             \bfseries\raggedright} ,
      headformat-instance = ttu@section ,
      mark-cmd            = \sectionmark{##1} ,
    }%
  \DeclareInstance{heading}{subsection}{display}
    {
      name                = subsection ,
      level               = 1 ,
      before-vspace       = 10pt ,
      after-vspace        = 5pt ,
      heading-decls       = {\normalfont\normalsize\bfseries\raggedright
                             \singlespacing} ,
      headformat-instance = ttu@section ,
      mark-cmd            = \subsectionmark{##1} ,
    }%
  \DeclareInstance{heading}{subsubsection}{display}
    {
      name                = subsubsection ,
      parent-name         = subsection ,
      level               = 2 ,
      before-vspace       = 8pt ,
      after-vspace        = 4pt ,
      heading-decls       = {\normalfont\normalsize\itshape\raggedright
                             \singlespacing} ,
      headformat-instance = ttu@section ,
    }%
  \DeclareInstance{heading}{paragraph}{display}
    {
      name                = paragraph ,
      parent-name         = subsubsection ,
      level               = 3 ,
      before-vspace       = 6pt ,
      after-vspace        = 3pt ,
      heading-decls       = {\normalfont\normalsize\raggedright\singlespacing} ,
      headformat-instance = ttu@section ,
    }%
  \DeclareInstance{heading}{subparagraph}{runin}
    {
      name                = subparagraph ,
      parent-name         = paragraph ,
      level               = 4 ,
      before-vspace       = 6pt ,
      after-vspace        = 0.6em ,
      heading-decls       = {\normalfont\normalsize\itshape} ,
      headformat-instance = ttu@subparagraph ,
    }%
}

%% Table of Contents lines, shifted by one level to match.  These have to
%% replace \l@section and friends wholesale rather than be patched, so the
%% inter-entry gap that section 12 adds by \pretocmd is written in by hand
%% here; \AtEndPreamble puts this after that patching, so it wins.
%%
%% \toclevel@... has to move with them.  It is what latex-lab's ToC tagging
%% tests against \c@tocdepth to decide whether an entry gets a /TOCI wrapper,
%% and it is read independently of the level these \l@... macros print at.
%% Leave the two disagreeing and an entry that prints without a wrapper hangs
%% a bare /Reference off the /TOC, which is a PDF/UA structure violation.
\newcommand{\ttu@sectiontoc}{%
  \def\toclevel@section{0}%
  \def\toclevel@subsection{1}%
  \def\toclevel@subsubsection{2}%
  \def\toclevel@paragraph{3}%
  \def\toclevel@subparagraph{4}%
  \renewcommand*\l@paragraph[2]{\ttu@dottedtocline{3}{4.5em}{4.4em}{##1}{##2}}%
  \renewcommand*\l@subparagraph[2]{\ttu@dottedtocline{4}{6.0em}{5.2em}{##1}{##2}}%
  \renewcommand*\l@section[2]{%
    \ttu@tocgap{0}{6\p@}{6\p@}%
    \begingroup\renewcommand{\ttu@tocfont}{\bfseries}%
      %% Level 0's format hook is \ttu@uctoc, which uppercases -- correct for
      %% a \chapter* entry (Abstract, Bibliography, ...) but wrong here: the
      %% manual requires the ToC to echo the document's own wording, and a
      %% sections-mode \section is no longer printed in caps (see 6b above).
      %% The depth test still needs literal level 0, so the entry survives
      %% \ThesisAppendices setting tocdepth to 0 -- only the FORMAT is
      %% overridden, and only inside this group, so \l@chapter's entries
      %% (still uppercase, manual p.18) are untouched.
      %%
      %% Appendices are the exception, and \ttu@tocappendixtrue -- written into
      %% the .toc by \ttu@appendixcommon -- marks where they begin.  From there
      %% on the entries are appendix titles, which print as uppercase banners
      %% like every other major division, so the ToC echoes them that way and
      %% the level-0 format is left alone.  Leaving it alone also restores the
      %% \ifblank guard in \ttu@uctoc@num, which is what stops a lone,
      %% unlettered appendix printing as a bare ". SUPPLEMENTARY MATERIAL".
      \ifttu@tocappendix\else
        \expandafter\let\csname contentsline@text@0@format\endcsname\@firstofone
      \fi
      \ttu@dottedtocline{0}{0em}{2.4em}{##1}{##2}%
    \endgroup}%
  %% subsection is bold and subsubsection is italic in the body (see
  %% \ttu@sectionheadings above); their ToC lines match it, using the same
  %% grouped, local \ttu@tocfont idiom as \l@section just above.
  \renewcommand*\l@subsection[2]{%
    \ttu@tocgap{1}{6\p@}{6\p@}%
    \begingroup\renewcommand{\ttu@tocfont}{\bfseries}%
      \ttu@dottedtocline{1}{1.5em}{2.8em}{##1}{##2}%
    \endgroup}%
  \renewcommand*\l@subsubsection[2]{%
    \ttu@tocgap{2}{\z@}{\z@}%
    \begingroup\renewcommand{\ttu@tocfont}{\itshape}%
      \ttu@dottedtocline{2}{3.0em}{3.6em}{##1}{##2}%
    \endgroup}%
}

%% \chapter has no meaning in this mode, and a student who copies a chapter
%% file into a sections-mode document would otherwise get a silent "CHAPTER I"
%% banner in the middle of it.  The starred form stays available: the front
%% matter, the three lists and the bibliography all use it.
\newcommand{\ttu@blockchapter}{%
  \NewCommandCopy{\ttu@realchapter}{\chapter}%
  \RenewDocumentCommand{\chapter}{s}{%
    \IfBooleanTF{##1}
      {\ttu@realchapter*}
      {\ClassError{ttuthesis2026}
         {\string\chapter\space does not exist when structure = sections}
         {This document is set up as a masters thesis with no chapters.
          Use \string\section\space for a top-level heading, \string\subsection
          \space below it, and so on.}%
       \ttu@realchapter}}%
}

\newcommand{\ttu@usesectionstructure}{%
  \ttu@sectionheadings
  \renewcommand{\thesection}      {\arabic{section}}%
  \renewcommand{\thesubsection}   {\thesection.\arabic{subsection}}%
  \renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}%
  %% Floats and equations restart in every top-level section and carry its
  %% number, which is the manual's decimal-consistency rule (p.22).
  \counterwithin{figure}{section}%
  \counterwithin{table}{section}%
  \counterwithin{equation}{section}%
  \AtEndPreamble{\ttu@sectiontoc\ttu@blockchapter}%
  \let\ttu@usesectionstructure\relax}   % apply it only once

%% JUSTIFICATION  (manual p.21)
%%   "Do NOT use full justification unless your word processing software is
%%    sufficiently sophisticated enough to keep your text from appearing with
%%    large gaps and spaces."
%%   TeX's total-fit paragraph breaker is precisely that software, so full
%%   justification is kept.  The test is objective and is run on every build:
%%   an over-stretched line is an Underfull \hbox warning, and the compliance
%%   check fails if the log contains any.  If a reviewer objects anyway,
%%   \ThesisRaggedRight in the preamble switches the whole document to
%%   ragged right without touching this file.
\newcommand{\ThesisRaggedRight}{%
  \AddToHook{begindocument/end}{%
    \raggedright
    \setlength{\parindent}{1.5em}%   \raggedright zeroes it; put it back
    \hyphenpenalty=1000 }}

%% PARAGRAPH INDENTATION  (manual p.21; Turabian A.1.4)
%%   Every body paragraph takes a first-line indent, INCLUDING the first one
%%   after a heading.  LaTeX suppresses that first indent by default.
%%   This is the indentfirst package's mechanism applied directly -- the whole
%%   of indentfirst.sty is these two lines -- which avoids loading a package
%%   whose tagging status is unverified, and works with the latex-lab heading
%%   instances because they close with the kernel's \@afterheading.
\let\@afterindentfalse\@afterindenttrue
\@afterindenttrue

%% FLOAT PLACEMENT  (manual p.22: a table or figure is mentioned in the text
%%   before it appears).  The stock report defaults forbid "here" and send
%%   floats to the top of the following page, which can land a table above the
%%   very section heading that introduces it.  Allowing h and giving floats
%%   most of the page keeps them with the text that declares them, which is
%%   also where the tag tree files them (see float/here below).
\renewcommand{\fps@figure}{htbp}
\renewcommand{\fps@table}{htbp}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.7}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.7}

%% Widow / orphan / dangling-subheading control (manual p.22).
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

%% ---------------------------------------------------------------------------
%% 7. CAPTIONS  (manual pp.21-23; Turabian 26.2.2 / 26.3.2)
%%    Flush left, single-spaced, "Figure 1.1. Title" with a period separator.
%%    Tables take the caption ABOVE, figures below.
%%
%%    latex-lab-testphase-float.sty re-defines \@makecaption from inside
%%    \AddToHook{begindocument}, so a class-level \def is dead.  The
%%    replacement therefore goes in a LATER hook and re-emits latex-lab's
%%    tagging sockets by hand, or /Caption, /Lbl and /P vanish.
%% ---------------------------------------------------------------------------
\@ifpackageloaded{latex-lab-testphase-float}{%
  \NewSocketPlug{caption/label}{ttu@period}{#1.~}%
  \AssignSocketPlug{caption/label}{ttu@period}%
  %% Tag each float where it is DECLARED, so it nests inside its own chapter
  %% or section instead of one pooled division at the end of the document.
  \tagpdfsetup{float/here}%
}{}

\AddToHook{begindocument/end}{%
  \long\def\@makecaption#1#2{%
    \vskip\abovecaptionskip
    \begingroup
      \setstretch{1.0}\normalfont\normalsize
      \setlength{\parindent}{\z@}\raggedright
      \UseTaggingSocket{caption/begin}{\@current@float@struct}%
      \UseTaggingSocket{caption/label/begin}%
      \UseSocket{caption/label}{#1}%
      \UseTaggingSocket{caption/label/end}%
      \UseTaggingSocket{para/begin}%
      #2%
      \par
      \UseTaggingSocket{caption/end}%
    \endgroup
    \vskip\belowcaptionskip}%
}
\setlength{\abovecaptionskip}{10pt}
\setlength{\belowcaptionskip}{0pt}

%% longtable draws its caption through \LT@makecaption, not \@makecaption, so
%% it needs the same treatment: flush left, single-spaced, "Table 1.2. Title"
%% with a period (longtable hard-codes a colon).  The table is left-aligned so
%% a full-width caption starts at the left margin above it.
\setlength{\LTleft}{0pt}
\setlength{\LTright}{\fill}
\setlength{\LTcapwidth}{\textwidth}
\AddToHook{begindocument/end}{%
  \def\LT@makecaption#1#2#3{%
    \LT@mcol\LT@cols l{\hbox to\z@{%
      %% The caption sits inside the table's first column, which begins one
      %% \tabcolsep in from the text margin.  Backing that out is what makes a
      %% longtable caption line up with an ordinary \caption to the pixel.
      \hspace*{-\tabcolsep}%
      \parbox[t]{\LTcapwidth}{%
        \setstretch{1.0}\normalfont\normalsize\raggedright
        #1{#2.\ }#3\endgraf\vskip\baselineskip}%
      \hss}}}%
}

%% Table captions sit above the tabular, so the skips have to swap for them.
%% Tables sit flush left, under their flush-left caption.  The manual is
%% silent on table alignment, so the governing rule is internal consistency
%% (p.22): a centred tabular under a flush-left caption reads as a mistake,
%% and a longtable cannot be centred here anyway (\LTleft below), so flush
%% left is the only choice that looks the same everywhere.  An author who
%% wants a particular table centred can still write \centering inside it.
\AtBeginEnvironment{table}{%
  \setlength{\abovecaptionskip}{0pt}%
  \setlength{\belowcaptionskip}{6pt}%
  \raggedright
}
\AtBeginEnvironment{longtable}{%
  \setlength{\abovecaptionskip}{0pt}%
  \setlength{\belowcaptionskip}{6pt}%
}

%% Header rows of every table are tagged /TH (manual p.22: real tables with
%% header rows).
\@ifpackageloaded{latex-lab-testphase-table}{%
  \tagpdfsetup{table/header-rows={1}}%
}{}

%% ---------------------------------------------------------------------------
%% 8. MATH TAGGING.  activate/spaces=false is NOT optional: automatic
%%    interword-space insertion overprints glyphs inside display maths.
%% ---------------------------------------------------------------------------
\@ifpackageloaded{latex-lab-testphase-math}{%
  \tagpdfsetup{activate/spaces=false}%
}{}

%% ---------------------------------------------------------------------------
%% 9. NAMES OF THE STANDARD DIVISIONS  (manual pp.17-20)
%% ---------------------------------------------------------------------------
\renewcommand{\contentsname}{Table of Contents}
\renewcommand{\listfigurename}{List of Figures}
\renewcommand{\listtablename}{List of Tables}
\renewcommand{\bibname}{Bibliography}
\renewcommand{\abstractname}{Abstract}
\renewcommand{\appendixname}{APPENDIX}
\newcommand{\acknowledgmentsname}{Acknowledgments}   % TTU spelling, no "e"
\newcommand{\abbreviationsname}{List of Abbreviations}

%% ---------------------------------------------------------------------------
%% 10. HYPERREF  (loaded late; biblatex needs it).  Links print black
%%     (manual p.25) but remain real, tagged links.
%% ---------------------------------------------------------------------------
\RequirePackage[hidelinks,pdfusetitle,pdfdisplaydoctitle=true]{hyperref}
\urlstyle{same}
%% Let a long URL break at its punctuation instead of running past the margin.
\Urlmuskip=0mu plus 1mu\relax
\def\UrlBreaks{\do\.\do\@\do\/\do\-\do\_\do\:\do\?\do\=\do\&\do\#\do\%}
\AtBeginDocument{%
  \hypersetup{
    pdftitle  = {\ttu@title},
    pdfauthor = {\ttu@shortname},
    pdfsubject= {\ttu@degreetype, \ttu@department, Texas Tech University},
    pdfkeywords={\ttu@keywords},
    pdflang   = {en-US}}%
}

%% ---------------------------------------------------------------------------
%% 11. BIBLIOGRAPHY  (manual p.25) -- biblatex/biber, IEEE numeric.
%%     Single-spaced within an entry, a blank line between entries, and no
%%     entry split across a page break.
%% ---------------------------------------------------------------------------
%% ---------------------------------------------------------------------------
%% WHICH FIELDS PRINT IN THE REFERENCES.  Each line below is one on/off
%% switch. Delete a line (or flip its "false" to nothing) to bring that field
%% back; see bibliography/references.bib for the full guide.
\RequirePackage[backend=biber,bibstyle=ieee,citestyle=ieee-comp,sorting=none,
                doi=false,    % -- remove this line to print DOIs
                isbn=false,   % -- remove this line to print ISBN/ISSN
                url=false,    % -- remove this line to print "[Online]. Available: <url>"
                eprint=false, % -- remove this line to print eprint/arXiv IDs
                ]{biblatex}
%% Belt-and-suspenders: clears these fields outright so no style change can
%% resurrect the text the options above already suppress. issn/url/urldate
%% only -- see references.bib for why "note" is left alone on purpose.
\AtEveryBibitem{\clearfield{issn}\clearfield{url}\clearfield{urldate}}
%% ---------------------------------------------------------------------------
\renewcommand*{\bibfont}{\normalfont\normalsize\setstretch{1.0}}
\setlength{\bibitemsep}{\baselineskip}
\AtBeginBibliography{\interlinepenalty=10000\relax}

%% \ThesisSetup{journal-abbreviations = true} calls this.  A biber source map
%% renames each entry's shortjournal field to journaltitle before the style
%% ever sees it, so abbreviated titles appear everywhere the full one would,
%% and entries without a shortjournal are simply left alone.
\newcommand{\ttu@usejournalabbreviations}{%
  \DeclareSourcemap{%
    \maps[datatype=bibtex]{%
      %% overwrite is a \map option, not a \step one.
      \map[overwrite]{%
        \step[fieldsource=shortjournal, fieldtarget=journaltitle]%
      }%
    }%
  }%
  \let\ttu@usejournalabbreviations\relax}  % declare it only once

%% ---------------------------------------------------------------------------
%% 12. TABLE OF CONTENTS / LIST OF FIGURES / LIST OF TABLES  (manual pp.18-19)
%%
%%     Everything runs on the KERNEL \l@chapter / \@dottedtocline path that
%%     latex-lab instruments, so every entry is a real tagged /TOCI with a
%%     working link and artifacted dot leaders.  tocloft is deliberately not
%%     used: it supplies its own \l@... macros that never fire the kernel
%%     hooks, which silently kills the links.
%% ---------------------------------------------------------------------------

%% A clone of latex-lab's \@dottedtocline with one addition: \ttu@tocfont,
%% so chapter lines (entry text AND page number) can be bold.  Every hook and
%% tagging socket of the original is preserved verbatim.
\newcommand{\ttu@tocfont}{}
\def\ttu@dottedtocline#1#2#3#4#5{%
  \ifnum #1>\c@tocdepth \else
    \vskip \z@ \@plus.2\p@
    {\leftskip #2\relax \rightskip \@tocrmarg \parfillskip -\rightskip
     \parindent #2\relax\@afterindenttrue
     \interlinepenalty\@M
     \leavevmode
     \ttu@tocfont
     \@tempdima #3\relax
     \advance\leftskip \@tempdima \null\nobreak\hskip -\leftskip
     \UseHookWithArguments{contentsline/text/before}{4}{#1}{#4}{#5}{\@contentsline@destination}%
     \csname contentsline@text@#1@format\endcsname{#4}%
     \UseHookWithArguments{contentsline/text/after}{4}{#1}{#4}{#5}{\@contentsline@destination}%
     \nobreak
     \UseTaggingSocket{toc/leaders/before}\SuspendTagging{toc/leaders}%
       \leaders\hbox{$\m@th
         \mkern \@dotsep mu\hbox{.}\mkern \@dotsep mu$}\hfill
     \ResumeTagging{toc/leaders}\UseTaggingSocket{toc/leaders/after}%
     \nobreak
     \hb@xt@\@pnumwidth{\hfil\normalcolor\ttu@tocfont
     \UseHookWithArguments{contentsline/page/before}{4}{#1}{#4}{#5}{\@contentsline@destination}%
     #5%
     \UseHookWithArguments{contentsline/page/after}{4}{#1}{#4}{#5}{\@contentsline@destination}%
                        \kern-\p@\kern\p@}%
     \par}%
  \fi}

%% Chapter lines read "I. CHAPTER TITLE", bold, with leaders.  The title is
%% uppercased to match the printed page (manual p.18) but the numeral is split
%% off first: uppercasing the whole entry swallows the \numberline group and
%% runs the numeral into the title ("IINTRODUCTION").
\def\ttu@uctoc{\@ifnextchar\numberline\ttu@uctoc@num\ttu@uctoc@plain}
%% The \ifblank guard is what lets \ThesisSingleAppendix work: that form
%% empties \thechapter, so the entry arrives as \numberline{} and would
%% otherwise be typeset as a bare ". APPENDIX".
\def\ttu@uctoc@num\numberline#1#2\ttu@uctocend{%
  \ifblank{#1}{}{\numberline{#1.}}\MakeUppercase{#2}}
\def\ttu@uctoc@plain#1\ttu@uctocend{\MakeUppercase{#1}}
\@namedef{contentsline@text@0@format}#1{\ttu@uctoc#1\ttu@uctocend}

%% Level indents follow the Graduate School front-matter template: chapter
%% flush left, each subheading level stepped in by 1.5em (18pt at 12pt).
\renewcommand*\l@chapter[2]{%
  \begingroup\renewcommand{\ttu@tocfont}{\bfseries}%
    \ttu@dottedtocline{0}{0em}{2.4em}{#1}{#2}%
  \endgroup}
%% Section and subsection print bold in the body (see the chapters-mode
%% heading instances above), so their ToC lines match, the same grouped,
%% local \ttu@tocfont idiom \l@chapter uses -- subsubsection is italic in
%% the body too, but at tocdepth 2 it never reaches the printed ToC, so
%% there is no line here for it to disagree with.
\renewcommand*\l@section[2]{%
  \begingroup\renewcommand{\ttu@tocfont}{\bfseries}%
    \ttu@dottedtocline{1}{1.5em}{2.8em}{#1}{#2}%
  \endgroup}
\renewcommand*\l@subsection[2]{%
  \begingroup\renewcommand{\ttu@tocfont}{\bfseries}%
    \ttu@dottedtocline{2}{3.0em}{3.6em}{#1}{#2}%
  \endgroup}
\renewcommand*\l@figure[2]    {\ttu@dottedtocline{1}{0em}{3.0em}{#1}{#2}}
\renewcommand*\l@table[2]     {\ttu@dottedtocline{1}{0em}{3.0em}{#1}{#2}}

%% Inter-entry spacing.  Manual pp.18-19: single-spaced inside an entry,
%% 1.5/double between entries, and a visible break when the level changes.
%% The gap depends on the level of the PRECEDING entry as well as this one,
%% which no per-level \...skip can express, so it is carried in \ttu@tocafter.
\newdimen\ttu@tocafter
\ttu@tocafter=\z@
%% #1 = level, #2 = space before, #3 = space carried to the next entry
\newcommand{\ttu@tocgap}[3]{%
  \ifnum #1>\c@tocdepth\relax\else
    \vskip\dimexpr\ttu@tocafter+#2\relax
    \global\ttu@tocafter=#3\relax
  \fi}
\AtEndPreamble{%
  \pretocmd{\l@chapter}   {\ttu@tocgap{0}{6\p@}{6\p@}}{}{}%
  \pretocmd{\l@section}   {\ttu@tocgap{1}{6\p@}{6\p@}}{}{}%
  \pretocmd{\l@subsection}{\ttu@tocgap{2}{\z@}{\z@}}{}{}%
  %% Figures and tables use their own depth counters, never \c@tocdepth, so
  %% -1 disables the depth test for them.
  \pretocmd{\l@figure}    {\ttu@tocgap{-1}{6\p@}{\z@}}{}{}%
  \pretocmd{\l@table}     {\ttu@tocgap{-1}{6\p@}{\z@}}{}{}%
}

%% Shared setup for all three lists.
\newcommand{\ttu@listsetup}{%
  \singlespacing
  \hyphenpenalty=10000 \exhyphenpenalty=10000
  %% Manual p.18: title text must not run into the page-number column.  The
  %% "plus 1fil" matters as much as the width: with hyphenation off, a rigid
  %% \rightskip lets an unbreakable full-caps line overflow the margin.
  \renewcommand{\@tocrmarg}{3.5em plus 1fil}%
  \global\ttu@tocafter=\z@
}

%% ---------------------------------------------------------------------------
%% 13. FRONT MATTER  (manual pp.15, 17-20)
%% ---------------------------------------------------------------------------
%% Title page spacing follows the Graduate School front-matter template:
%% single-spaced inside a block, one blank line between blocks, two before the
%% dean's block and before the date.
\newlength{\ttu@tpgap}    \setlength{\ttu@tpgap}{14pt}
\newlength{\ttu@tpbiggap} \setlength{\ttu@tpbiggap}{28pt}

\newcommand{\ThesisTitlePage}{%
  \begin{titlepage}
  \thispagestyle{ttuempty}
  \begin{singlespace}
  \begin{center}
    \ttu@title\\[\ttu@tpbiggap]
    by\\[\ttu@tpgap]
    \ttu@fullname\\[\ttu@tpgap]
    A \ifdefstring{\ttu@degreetype}{thesis}{Thesis}{Dissertation}\\[\ttu@tpgap]
    In\\[\ttu@tpgap]
    \ttu@department\\[\ttu@tpgap]
    Submitted to the Graduate Faculty\\
    of Texas Tech University in\\
    Partial Fulfillment of\\
    the Requirements for\\
    the Degree of\\[\ttu@tpgap]
    \MakeUppercase{\ttu@degree}\\[\ttu@tpgap]
    Approved\\[\ttu@tpgap]
    \ttu@chair\\
    Chair of the Committee\\[\ttu@tpgap]
    \ttu@committeelines\\[\ttu@tpbiggap]
    \ttu@dean\\
    Dean of the Graduate School\\[\ttu@tpbiggap]
    \ttu@month\ \ttu@year
  \end{center}
  \end{singlespace}
  \end{titlepage}}

%% Copyright page: centred both ways, no page number.  \vfill (not \vfil):
%% under \raggedbottom the output routine's own \vfil-order glue would
%% compete and drag the block above true centre.
\newcommand{\ThesisCopyrightPage}{%
  \newpage
  \thispagestyle{ttuempty}%
  \null\vfill
  \begin{center}\begin{singlespace}
    Copyright \ttu@year, \ttu@shortname
  \end{singlespace}\end{center}
  \vfill\null
  \newpage}

%% Title page + copyright page + roman page numbering.  The running header
%% starts with the next division, which is the Acknowledgments (manual p.15).
\newcommand{\ThesisFrontMatter}{%
  %% The title and copyright pages print no number, but hyperref still names a
  %% destination after \thepage.  Left on arabic they would be "page.1" and
  %% "page.2", colliding with the first two pages of Chapter I.  A throwaway
  %% alphabetic scheme keeps those two destinations unique.
  \pagenumbering{alph}%
  \ThesisTitlePage
  %% report's titlepage environment resets the page counter to 1 on the way
  %% out, which would give the copyright page the same destination name.
  \setcounter{page}{2}%
  \ThesisCopyrightPage
  \clearpage
  \pagenumbering{roman}%
  \setcounter{page}{2}%
  \pagestyle{ttumain}}

%% An unnumbered top-level division, listed in the ToC and the PDF bookmarks.
%% \clearpage first so the ToC line records the page the title actually lands
%% on; \chapter* then opens the tagged /Sect and prints the title.
\newcommand{\ThesisFrontSection}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%
  \chapter*{#1}}

\newcommand{\ThesisAcknowledgments}{\ThesisFrontSection{\acknowledgmentsname}}
\newcommand{\ThesisAbstract}{\ThesisFrontSection{\abstractname}}
\newcommand{\ThesisAbbreviations}{\ThesisFrontSection{\abbreviationsname}}

%% List of Abbreviations (manual pp.19-20): alphabetised by abbreviation,
%% single-spaced inside a multi-line explanation, 1.5 spacing between entries.
%%
%% Layout is a two-column definition list, not a tabular: latex-lab tags it as
%% /L with /Lbl + /LBody per item, which is what a glossary actually is, and it
%% breaks across pages without any of longtable's header machinery.
%% \makebox[\labelwidth][l] is the alignment fix -- LaTeX's \@item otherwise
%% typesets a short label at its natural width inside a \labelwidth box, which
%% right-aligns it and leaves the definitions looking ragged.
\newlength{\ttu@abbrevwidth}
\newenvironment{abbreviationlist}[1][1.25in]
  {\setlength{\ttu@abbrevwidth}{#1}%
   \begin{list}{}{%
     \setlength{\labelwidth}{\ttu@abbrevwidth}%
     \setlength{\leftmargin}{\dimexpr\ttu@abbrevwidth+\labelsep\relax}%
     \setlength{\itemindent}{0pt}%
     \setlength{\listparindent}{0pt}%
     \setlength{\rightmargin}{0pt}%
     \setlength{\topsep}{0pt}%
     \setlength{\partopsep}{0pt}%
     \setlength{\parsep}{0pt}%
     \setlength{\itemsep}{0.5\baselineskip}%
     \renewcommand{\makelabel}[1]{\makebox[\labelwidth][l]{##1}}}}
  {\end{list}}
\newcommand{\abbrev}[2]{%
  \item[#1]\begin{singlespace}\raggedright #2\end{singlespace}}

%% report's \tableofcontents / \listof... all call \chapter*, so each already
%% opens its own tagged division and prints its title through the chapter
%% heading instance.  The ToC itself is not listed in the ToC (manual p.18);
%% the two lists are.
\newcommand{\ThesisTableOfContents}{%
  \clearpage
  \begingroup \ttu@listsetup \tableofcontents \endgroup
  %% \ThesisAppendices writes a tocdepth change into the .toc file; put it
  %% back so the List of Figures and List of Tables are not suppressed.
  \setcounter{tocdepth}{2}%
  \clearpage}

\newcommand{\ThesisListOfTables}{%
  \clearpage \phantomsection
  \addcontentsline{toc}{chapter}{\listtablename}%
  \begingroup \ttu@listsetup \listoftables \endgroup
  \clearpage}

\newcommand{\ThesisListOfFigures}{%
  \clearpage \phantomsection
  \addcontentsline{toc}{chapter}{\listfigurename}%
  \begingroup \ttu@listsetup \listoffigures \endgroup
  \clearpage}

%% ---------------------------------------------------------------------------
%% 14. MAIN MATTER, BIBLIOGRAPHY, APPENDICES  (manual pp.15, 25)
%% ---------------------------------------------------------------------------
\newcommand{\ThesisMainMatter}{%
  \clearpage
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
  \pagestyle{ttumain}}

\newcommand{\ThesisBibliography}{%
  \clearpage \phantomsection
  \addcontentsline{toc}{chapter}{\bibname}%
  \chapter*{\bibname}%
  \printbibliography[heading=none]%
  \clearpage}

%% Appendices.  \ThesisAppendices is the only command a student writes, and it
%% letters itself: the manual (p.25) wants two or more appendices lettered
%% A, B, C and styled like chapter titles, but a lone appendix left unlettered,
%% so the class counts the appendices the document actually contains and picks
%% the right form.
%%
%%   two or more appendices -> "APPENDIX A", "APPENDIX B", headings A.1, B.1,
%%                             floats "Table A.1", "Figure B.2", equations A.1
%%   exactly one appendix   -> "APPENDIX" with no letter, headings 1, 2,
%%                             floats "Table 1", "Figure 1", equations (1)
%%
%% In both forms the appendix title is styled like the document's top-level
%% heading (a chapter title in chapters mode, a section title in sections
%% mode) and appears in the ToC, while appendix SUBHEADINGS are not listed
%% (manual p.25).  \ttu@appendixcommon's own \clearpage keeps the appendix
%% opening on a fresh page in sections mode even though the section heading
%% instance no longer forces one.
%%
%% WHY PLAIN NUMBERS IN A LONE APPENDIX.  The manual mandates the unlettered
%% title (p.25) and requires appendix tables and figures to be numbered and
%% listed (p.25), but says nothing about the FORM of those numbers, so the
%% approved style guide governs (p.5).  Turabian's own rule is that a lone
%% appendix is headed simply "Appendix" with no letter (9th ed., p.410) and
%% that double numeration belongs to material sitting inside a numbered
%% division; matter outside one is numbered straight through.  An unlettered
%% appendix has no division number for a decimal to hang off, so "Table A.1"
%% would print a letter the manual has just struck from the title.  The p.22
%% consistency rule is satisfied either way -- it asks that a document using
%% decimal numbering use it for headings, floats and equations alike, and the
%% lone appendix drops all three together rather than mixing the two schemes.
%% Nothing collides: the body's floats are "Table 1.1", never "Table 1".
%%
%% HOW THE COUNT IS TAKEN.  \appendix zeroes the counter that the appendix
%% top-level headings step (chapter in chapters mode, section in sections
%% mode), so at \end{document} that counter simply IS the number of
%% appendices.  It is written into the .aux and read back at the start of the
%% next run, the same round trip the ToC and cross-references already use.  A
%% first pass over a fresh document therefore letters the appendices -- the
%% safe default, since un-lettering several appendices would print the same
%% bare "APPENDIX" over each of them -- and the following pass settles on the
%% right form.  A hand-run single pass may need the usual re-run, and the class
%% says so in a warning.  The count does not depend on the form chosen, so the
%% round trip cannot oscillate.  Un-lettering shifts the ToC entry and with it
%% every structure number after it, which needs one further pass to be read
%% back cleanly; that is why the build scripts run four passes, not three.
\newcommand{\ttu@appcount}{0}          % appendices seen on the previous run
\newcommand{\ttu@setappcount}[1]{\gdef\ttu@appcount{#1}}
\newcommand{\ttu@appnow}{0}            % appendices seen on this run
\newif\ifttu@inappendix
%% Set while the .toc is being TYPESET, not while it is being written: it is
%% switched on by a line \ttu@appendixcommon puts into the .toc file itself,
%% so that \l@section can tell body entries from appendix entries.
\newif\ifttu@tocappendix

\newcommand{\ttu@appendixcommon}{%
  \clearpage
  \appendix
  \ttu@inappendixtrue
  \renewcommand{\chaptername}{\appendixname}%
  \addtocontents{toc}{\protect\setcounter{tocdepth}{0}}%
  \addtocontents{toc}{\protect\ttu@tocappendixtrue}%
  \ttu@ifsections{\ttu@appendix@sectionbreak}{}%
  \setcounter{figure}{0}\setcounter{table}{0}\setcounter{equation}{0}}

\AtEndDocument{%
  \ifttu@inappendix
    \ttu@ifsections
      {\xdef\ttu@appnow{\the\value{section}}}
      {\xdef\ttu@appnow{\the\value{chapter}}}%
    \immediate\write\@auxout{\string\ttu@setappcount{\ttu@appnow}}%
    \ifnum\ttu@appnow=\ttu@appcount\relax\else
      \ClassWarningNoLine{ttuthesis2026}
        {The number of appendices changed; run the build again so the
         appendix lettering settles}%
    \fi
  \fi}

%%
%% APPENDIX TITLES ARE DIVISION BANNERS IN BOTH MODES.  The manual asks that
%% appendix titles be styled like chapter titles (p.25), which is a statement
%% about RANK: an appendix is a major division, the peer of the Bibliography
%% and the Abstract, not a heading inside the body.  Those divisions are set
%% the same way in either structure -- centred, uppercase, at the top of a
%% fresh page -- so appendices are too.  In chapters mode \chapter already
%% does that.  In sections mode the top-level heading is \section, which
%% normally prints flush left and runs on from the text above it, so inside
%% the appendices its instance is re-declared to the chapter banner and
%% \ttu@appendix@sectionbreak gives every appendix its own page.  The heading
%% stays at level 0, so the tagged structure is unchanged: the appendix title
%% is H1 and its \subsection subheadings are H2, exactly as before.
\newcommand{\ThesisAppendices}{%
  \ttu@appendixcommon
  \ifnum\ttu@appcount=1\relax
    \ttu@appendix@single
  \else
    \ttu@appendix@lettered
  \fi}

%% Kept so that documents written against the older two-command interface keep
%% compiling.  Detection makes the distinction by itself, so this is simply
%% \ThesisAppendices under its former name.
\newcommand{\ThesisSingleAppendix}{\ThesisAppendices}

%% Guard at the top of the section-style sample files.  \chapter already
%% refuses to run in sections mode (\ttu@blockchapter in section 6b); this is
%% the mirror image.  Without it a section-style file dropped into a chapters
%% document is not an error at all -- \section is perfectly legal there, it
%% just means SUBHEADING -- so the file silently becomes part of whatever
%% division preceded it.  As an appendix that is invisible and expensive: the
%% appendix count stays at one, so the whole run reverts to the unlettered
%% form and the second appendix arrives as a numbered subheading of the first,
%% with no banner and no page break.  Better to stop and say which file to use.
\newcommand{\ThesisSectionsOnly}{%
  \ttu@ifsections{}{%
    \ClassError{ttuthesis2026}
      {This file is written for structure = sections}
      {Its headings start at \string\section, which in a chapters document is a
       SUBHEADING rather than a division, so the file would be absorbed into
       whatever came before it.\MessageBreak
       Either input the chapter-style file of the same name instead, or set
       structure = {sections} in config/thesis-config.tex.}}}

%% Sections mode only: re-declare the top-level \section as the chapter-style
%% banner used by every other major division.  Same keys as the chapter
%% instance in section 6 above, with level 0 kept so the tagging and the ToC
%% depth test are untouched, and \thesection (the letter, or nothing at all)
%% supplying the number after the "APPENDIX" prefix.
\newcommand{\ttu@appendix@sectionbanner}{%
  \DeclareInstance{heading}{section}{display}
    {
      name                 = section ,
      level                = 0 ,
      placement            = top ,
      before-vspace        = \ttu@chaptop ,
      after-penalty-vspace = 0pt ,
      after-vspace         = 8pt ,
      prefix               = {\MakeUppercase{\appendixname}} ,
      number-format        = \thesection ,
      heading-decls        = {\normalfont\singlespacing\ttu@chapterfont
                              \bfseries\centering} ,
      headformat-instance  = ttu@chapter ,
      mark-cmd             = \sectionmark{##1} ,
    }%
}

%% ... and give each one its own page.  \chapter carries its own \clearpage in
%% the other mode; \section does not, so it is wrapped here.  Only the appendix
%% run is affected: the wrapper is installed by \ttu@appendixcommon, after all
%% body sections have already been set.
\newcommand{\ttu@appendix@sectionbreak}{%
  \NewCommandCopy{\ttu@app@realsection}{\section}%
  \RenewDocumentCommand{\section}{som}{%
    \clearpage
    \IfBooleanTF{##1}
      {\ttu@app@realsection*{##3}}
      {\IfNoValueTF{##2}
        {\ttu@app@realsection{##3}}
        {\ttu@app@realsection[##2]{##3}}}}%
}

\newcommand{\ttu@appendix@lettered}{%
  \ttu@ifsections
    {\setcounter{section}{0}%
     \renewcommand{\thesection}{\Alph{section}}%
     \ttu@appendix@sectionbanner}
    {\renewcommand{\ttu@chapnum}{\thechapter}}}

%% The unlettered form works by emptying \thechapter (or, in sections mode,
%% \thesection): the top-level heading instance then prints its prefix
%% ("APPENDIX") with no numeral after it, and the ToC entry drops the numeral
%% too (see the \ifblank guard in \ttu@uctoc@num above).
\newcommand{\ttu@appendix@single}{%
  \ttu@ifsections
    {\setcounter{section}{0}%
     \renewcommand{\thesection}{}%
     \ttu@appendix@sectionbanner
     \renewcommand{\thesubsection}{\arabic{subsection}}%
     \renewcommand{\thefigure}{\arabic{figure}}%
     \renewcommand{\thetable}{\arabic{table}}%
     \renewcommand{\theequation}{\arabic{equation}}}
    {\ttu@singleappendix@chapters}}

\newcommand{\ttu@singleappendix@chapters}{%
  \renewcommand{\thechapter}{}%
  %% Subheadings drop the chapter component too, or the lone appendix would
  %% number its first section "1.1" -- the same string Chapter I already used.
  \renewcommand{\thesection}{\arabic{section}}%
  \renewcommand{\thefigure}{\arabic{figure}}%
  \renewcommand{\thetable}{\arabic{table}}%
  \renewcommand{\theequation}{\arabic{equation}}}

\endinput
